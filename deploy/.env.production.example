# ============================================================
# ContentOS — Production Environment Template
# Domain:  https://hidustansocialnetwork.in
# API:     https://api.hidustansocialnetwork.in
#
# INSTRUCTIONS:
#   1. Copy this file to /home/hindust1/contentos/.env
#   2. Fill in every REPLACE_WITH_* value before starting
#   3. NEVER commit .env to Git — it is in .gitignore
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=production
NODE_ENV=production

# Must match the domain that serves the frontend
APP_URL=https://hidustansocialnetwork.in
APP_ORIGIN=https://hidustansocialnetwork.in

# cPanel "Setup Node.js App" will set PORT automatically via Passenger.
# Leave as 3001 locally; cPanel overrides it via environment.
PORT=3001

# ── PostgreSQL (Neon) ─────────────────────────────────────────
# Retain your existing Neon database for now
PGHOST=ep-odd-wind-b309rvnv.c-4.ap-southeast-1.aws.neon.tech
PGPORT=5432
PGDATABASE=smm-panel
PGUSER=neondb_owner
PGPASSWORD=REPLACE_WITH_NEON_PASSWORD
DATABASE_URL=postgresql://neondb_owner:REPLACE_WITH_NEON_PASSWORD@ep-odd-wind-b309rvnv.c-4.ap-southeast-1.aws.neon.tech/smm-panel?sslmode=require

# ── Redis ─────────────────────────────────────────────────────
# IMPORTANT: cPanel shared hosting does NOT include Redis.
# Options (verify with host):
#   A) Redis Cloud free tier (redis://default:PASSWORD@localhost:PORT)
#   B) Upstash Redis (redis://default:PASSWORD@HOST:PORT)
#   C) Check if cPanel host provides Redis via WHM
REDIS_URL=redis://REPLACE_WITH_REDIS_HOST:6379

# ── Security ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_eg_openssl_rand_hex_32
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_SAME_64_HEX_CHARS_AS_ENCRYPTION_KEY
JWT_SECRET=REPLACE_WITH_RANDOM_STRING_MIN_64_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_STRING_MIN_64_CHARS

# ── Email (Gmail SMTP) ────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=hindustansocialnetwork@gmail.com
MAIL_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_FROM_ADDRESS=hindustansocialnetwork@gmail.com

# ── Object Storage ────────────────────────────────────────────
# Option A: S3-compatible (Cloudflare R2, Backblaze B2, AWS S3)
# Set all four vars → S3 provider is activated automatically
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://REPLACE_WITH_R2_OR_S3_ENDPOINT
STORAGE_REGION=auto
STORAGE_BUCKET=contentos-media
STORAGE_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_WITH_SECRET_KEY
STORAGE_FORCE_PATH_STYLE=false

# Option B: Local disk fallback (NO CLOUD STORAGE)
# Leave STORAGE_ENDPOINT, STORAGE_ACCESS_KEY, STORAGE_SECRET_KEY blank.
# Files will be stored in uploads/ relative to the app root.
# STORAGE_LOCAL_DIR=/home/hindust1/contentos/uploads
# STORAGE_BUCKET=contentos-media

# ── LLM / AI ─────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=openrouter,gemini
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=4

GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
GROQ_MODEL=qwen/qwen3-27b

OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
OPENROUTER_MODEL=google/gemini-2.5-flash

FEATURE_KNOWLEDGE_ENGINE=true

# ── ClipDrop ──────────────────────────────────────────────────
CLIPDROP_API_KEY=REPLACE_WITH_CLIPDROP_KEY

# ── Social OAuth ──────────────────────────────────────────────
LINKEDIN_CLIENT_ID=REPLACE_WITH_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=REPLACE_WITH_LINKEDIN_CLIENT_SECRET
LINKEDIN_API_VERSION=202609
LINKEDIN_REDIRECT_URI=https://hidustansocialnetwork.in/api/v1/social/accounts/linkedin/callback

YOUTUBE_CLIENT_ID=REPLACE_WITH_YOUTUBE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=REPLACE_WITH_YOUTUBE_CLIENT_SECRET
YOUTUBE_REDIRECT_URI=https://hidustansocialnetwork.in/api/v1/social/accounts/youtube/callback

FACEBOOK_APP_ID=REPLACE_WITH_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=REPLACE_WITH_FACEBOOK_APP_SECRET
FACEBOOK_REDIRECT_URI=https://api.hidustansocialnetwork.in/api/v1/social/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v25.0

TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
INSTAGRAM_CLIENT_ID=REPLACE_WITH_INSTAGRAM_APP_ID
INSTAGRAM_CLIENT_SECRET=REPLACE_WITH_INSTAGRAM_APP_SECRET

# ── Admin ─────────────────────────────────────────────────────
SYSTEM_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
SYSTEM_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ── Optional ──────────────────────────────────────────────────
REQUIRE_LOGIN_OTP=true
