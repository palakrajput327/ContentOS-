# =========================
# APP CONFIGURATION
# =========================
APP_ENV=development
NODE_ENV=development

APP_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173
PORT=3001

# =========================
# POSTGRESQL DATABASE
# =========================
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=contentos
PGUSER=postgres
PGPASSWORD=

DATABASE_URL=postgresql://LOCAL_USER:LOCAL_PASSWORD@localhost:5432/LOCAL_DATABASE

# =========================
# REDIS QUEUE SERVICE
# =========================
REDIS_URL=redis://127.0.0.1:6379

# =========================
# JWT / SECURITY ENCRYPTION
# =========================
JWT_SECRET=
JWT_REFRESH_SECRET=

ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY=

# =========================
# FRONTEND / VITE
# =========================
VITE_API_ENABLED=true
VITE_AUTH_PHASE_ONLY=false
VITE_PRODUCT_NAME=ContentOS
VITE_API_URL=http://localhost:3001/api

# =========================
# MAIL / SMTP
# =========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=Hindustansocialnetwork
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hindustansocialnetwork@gmail.com
MAIL_SECURE=false

# =========================
# LLM & AI PROVIDERS
# =========================
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,openrouter
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Meta Facebook Login (keep Meta dashboard in Development mode)
FACEBOOK_APP_ID=your_meta_app_id
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://hindustandigitalworkshop.info/api/v1/social/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v25.0

# Public URL of this API when serving local uploads to Meta (optional for cloud storage)
META_MEDIA_PUBLIC_BASE_URL=
