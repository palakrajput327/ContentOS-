# ==========================================================================
# ContentOS — Production Environment
# Domain:  api.hidustansocialnetwork.in
# NEVER commit this file to Git. Place manually on server.
# ==========================================================================

# --------------------------
# App
# --------------------------
NODE_ENV=production
APP_ENV=production
PORT=3001

# Frontend URL (for CORS, OAuth redirects, email links)
APP_URL=https://hidustansocialnetwork.in
APP_ORIGIN=https://hidustansocialnetwork.in

# Public URL of the API itself
PUBLIC_URL=https://api.hidustansocialnetwork.in

# --------------------------
# PostgreSQL (Neon Cloud)
# --------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --------------------------
# Redis (cPanel or external)
# --------------------------
REDIS_URL=redis://127.0.0.1:6379

# --------------------------
# Security Keys (generate new ones for production!)
# openssl rand -hex 32
# --------------------------
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

# --------------------------
# Mail / SMTP
# --------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=hindustansocialnetwork@gmail.com
MAIL_PASSWORD=YOUR_APP_PASSWORD_HERE
MAIL_FROM_ADDRESS=hindustansocialnetwork@gmail.com

# --------------------------
# LLM / AI Providers
# --------------------------
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDERS=groq,openrouter
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=google/gemini-2.5-flash

# --------------------------
# Social — Meta (Facebook + Instagram)
# --------------------------
FACEBOOK_APP_ID=YOUR_META_APP_ID
FACEBOOK_APP_SECRET=YOUR_META_APP_SECRET
FACEBOOK_REDIRECT_URI=https://api.hidustansocialnetwork.in/api/v1/social/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v25.0

META_MEDIA_PUBLIC_BASE_URL=https://api.hidustansocialnetwork.in

# --------------------------
# Social — LinkedIn
# --------------------------
LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET
LINKEDIN_REDIRECT_URI=https://api.hidustansocialnetwork.in/api/v1/social/linkedin/callback
LINKEDIN_API_VERSION=202609

# --------------------------
# Social — X (Twitter)
# --------------------------
X_CLIENT_ID=YOUR_X_CLIENT_ID
X_CLIENT_SECRET=YOUR_X_CLIENT_SECRET
X_REDIRECT_URI=https://api.hidustansocialnetwork.in/api/v1/social/x/callback

# --------------------------
# Social — YouTube / Google
# --------------------------
YOUTUBE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
YOUTUBE_REDIRECT_URI=https://api.hidustansocialnetwork.in/api/v1/social/youtube/callback

# --------------------------
# Storage (Cloudflare R2 or S3)
# Leave blank = local disk storage (not recommended for production)
# --------------------------
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=contentos-media
STORAGE_ACCESS_KEY=YOUR_R2_ACCESS_KEY
STORAGE_SECRET_KEY=YOUR_R2_SECRET_KEY
STORAGE_REGION=auto
