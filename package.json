{
  "name": "contentos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --configLoader runner",
    "build": "node scripts/build.mjs",
    "build:api": "tsc -p server/tsconfig.json",
    "build:backend": "tsc -p server/tsconfig.json",
    "build:frontend": "cross-env VITE_API_BASE=https://api.hidustansocialnetwork.in vite build",
    "start": "node app.mjs",
    "start:api": "node --env-file=.env dist-api/phase-main.js",
    "migrate": "node --env-file=.env dist-api/migrate.js",
    "test": "npm run build:api && node scripts/test-auth.mjs",
    "start:mail": "node --env-file=.env dist-api/mail-worker.js",
    "start:worker": "node --env-file=.env dist-api/worker.js",
    "local:services": "node scripts/local-services.mjs",
    "preview:local": "vite preview --host localhost --port 5173 --configLoader runner",
    "test:llm": "npm run build:api && node --test scripts/test-llm-fallback.mjs && node scripts/test-knowledge.mjs",
    "test:youtube": "npm run build:api && node --test scripts/test-youtube-publishing.mjs && node scripts/test-youtube-connection.mjs",
    "verify:ffmpeg": "node scripts/verify-ffmpeg.mjs",
    "test:runtime": "npm run build:api && node --experimental-test-module-mocks --test scripts/test-queue-runtime.mjs scripts/test-mail-runtime.mjs scripts/test-pdf-runtime.mjs",
    "test:postgres-queue": "npm run build:api && node --experimental-test-module-mocks --test scripts/test-postgres-queue.mjs",
    "queue:reconcile": "node --env-file=.env dist-api/queue-reconcile.js",
    "queue:export:bullmq": "node --env-file=.env dist-api/bullmq-export.js",
    "build:deploy": "node scripts/deployment-artifact.mjs build",
    "test:deploy": "node scripts/test-deployment-artifact.mjs && node scripts/test-production-frontend.mjs && node scripts/test-cpanel-deploy.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@hookform/resolvers": "^3.10.0",
    "@napi-rs/canvas": "0.1.80",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@tanstack/react-query": "^5.66.0",
    "bullmq": "^5.40.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.0.0",
    "express-rate-limit": "^7.5.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.468.0",
    "nodemailer": "^7.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^7.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "embedded-postgres": "17.10.0-beta.17",
    "fflate": "^0.8.2",
    "pg-mem": "^3.0.5",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
